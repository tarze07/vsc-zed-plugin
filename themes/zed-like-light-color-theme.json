  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "#687180",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": ["storage.type.class.jsdoc", "entity.name.type.instance.jsdoc"],
      "settings": {
        "foreground": "#8340b8"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#8340b8"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type"],
      "settings": {
        "foreground": "#8340b8"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#4f5866"
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.typeof",
        "keyword.operator.instanceof"
      ],
      "settings": {
        "foreground": "#8340b8"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#5b6270"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#3b7a26"
      }
    },
    {
      "name": "Template expressions",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": {
        "foreground": "#8340b8"
      }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": {
        "foreground": "#167473"
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#167473"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#a8501a"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#1f5fbf"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#8a6300"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#2b3038"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": {
        "foreground": "#8f4a2a"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#a33a55"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#b4323b"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#8a6300"
      }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": {
        "foreground": "#a8501a"
      }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.property-value", "keyword.other.unit"],
      "settings": {
        "foreground": "#a8501a"
      }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": {
        "foreground": "#1f5fbf",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#a8501a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#8340b8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": {
        "foreground": "#687180",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link", "markup.link"],
      "settings": {
        "foreground": "#167473",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": {
        "foreground": "#3b7a26"
      }
    },
    {
      "name": "Markup quotes",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#687180",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup lists",
      "scope": ["punctuation.definition.list", "beginning.punctuation.definition.list"],
      "settings": {
        "foreground": "#8340b8"
      }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#3b7a26"
      }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#b4323b"
      }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#8a6300"
      }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#1f5fbf"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#c4202b",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#a8501a",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8a6300",
    "type": "#8a6300",
    "class": "#8a6300",
    "enum": "#8a6300",
    "interface": "#8a6300",
    "struct": "#8a6300",
    "typeParameter": "#8a6300",
    "parameter": "#8f4a2a",
    "variable": "#2b3038",
    "variable.readonly": "#a8501a",
    "variable.defaultLibrary": "#a8501a",
    "property": "#a33a55",
    "property.readonly": "#a33a55",
    "enumMember": "#a8501a",
    "event": "#a33a55",
    "function": "#1f5fbf",
    "method": "#1f5fbf",
    "macro": "#1f5fbf",
    "decorator": "#a8501a",
    "label": "#8340b8",
    "keyword": "#8340b8",
    "comment": {
      "foreground": "#687180",
      "italic": true
    },
    "string": "#3b7a26",
    "number": "#a8501a",
    "regexp": "#167473",
    "operator": "#4f5866",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
