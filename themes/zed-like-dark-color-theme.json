  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "#848c9a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": ["storage.type.class.jsdoc", "entity.name.type.instance.jsdoc"],
      "settings": {
        "foreground": "#c69ae8"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.modifier",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#c69ae8"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type"],
      "settings": {
        "foreground": "#c69ae8"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#a9b4c4"
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word",
        "keyword.operator.typeof",
        "keyword.operator.instanceof"
      ],
      "settings": {
        "foreground": "#c69ae8"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#a2aab7"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#9ccb83"
      }
    },
    {
      "name": "Template expressions",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": {
        "foreground": "#c69ae8"
      }
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": {
        "foreground": "#6ccbc4"
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#6ccbc4"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#e3a26e"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#6fb1e6"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#ddc078"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#cdd2da"
      }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": {
        "foreground": "#e0b8a0"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#e3a6a9"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#e57f84"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#ddc078"
      }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": {
        "foreground": "#e3a26e"
      }
    },
    {
      "name": "CSS values",
      "scope": ["support.constant.property-value", "keyword.other.unit"],
      "settings": {
        "foreground": "#e3a26e"
      }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": {
        "foreground": "#6fb1e6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#e3a26e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#c69ae8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": {
        "foreground": "#848c9a",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link", "markup.link"],
      "settings": {
        "foreground": "#6ccbc4",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": {
        "foreground": "#9ccb83"
      }
    },
    {
      "name": "Markup quotes",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#848c9a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup lists",
      "scope": ["punctuation.definition.list", "beginning.punctuation.definition.list"],
      "settings": {
        "foreground": "#c69ae8"
      }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#9ccb83"
      }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#e57f84"
      }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#ddc078"
      }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#6fb1e6"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#ff8a8f",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#e3a26e",
        "fontStyle": "strikethrough"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#ddc078",
    "type": "#ddc078",
    "class": "#ddc078",
    "enum": "#ddc078",
    "interface": "#ddc078",
    "struct": "#ddc078",
    "typeParameter": "#ddc078",
    "parameter": "#e0b8a0",
    "variable": "#cdd2da",
    "variable.readonly": "#e3a26e",
    "variable.defaultLibrary": "#e3a26e",
    "property": "#e3a6a9",
    "property.readonly": "#e3a6a9",
    "enumMember": "#e3a26e",
    "event": "#e3a6a9",
    "function": "#6fb1e6",
    "method": "#6fb1e6",
    "macro": "#6fb1e6",
    "decorator": "#e3a26e",
    "label": "#c69ae8",
    "keyword": "#c69ae8",
    "comment": {
      "foreground": "#848c9a",
      "italic": true
    },
    "string": "#9ccb83",
    "number": "#e3a26e",
    "regexp": "#6ccbc4",
    "operator": "#a9b4c4",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
