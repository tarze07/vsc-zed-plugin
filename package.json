{
  "name": "vsc-zed-plugin",
  "displayName": "Zed-like Agent Workspace",
  "description": "Zed-like layout for VS Code with multi-agent sessions (Claude Code, Codex, Agy, Kilo Code).",
  "version": "0.0.1",
  "publisher": "tarze07",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/tarze07/vsc-zed-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/tarze07/vsc-zed-plugin/issues"
  },
  "homepage": "https://github.com/tarze07/vsc-zed-plugin#readme",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "zed",
    "layout",
    "agents",
    "ai",
    "worktree"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "zedLayout.hello",
        "title": "Hello",
        "category": "Zed Layout"
      },
      {
        "command": "zedLayout.apply",
        "title": "Apply Zed Layout",
        "category": "Zed Layout"
      },
      {
        "command": "zedLayout.restore",
        "title": "Restore Previous Layout",
        "category": "Zed Layout"
      },
      {
        "command": "zedLayout.agents.newSession",
        "title": "New Agent Session",
        "category": "Zed Layout",
        "icon": "$(add)"
      },
      {
        "command": "zedLayout.agents.focus",
        "title": "Focus Agent Session",
        "category": "Zed Layout",
        "icon": "$(terminal)"
      },
      {
        "command": "zedLayout.agents.rename",
        "title": "Rename Agent Session",
        "category": "Zed Layout",
        "icon": "$(edit)"
      },
      {
        "command": "zedLayout.agents.stop",
        "title": "Stop Agent Session",
        "category": "Zed Layout",
        "icon": "$(debug-stop)"
      },
      {
        "command": "zedLayout.agents.restart",
        "title": "Restart Agent Session",
        "category": "Zed Layout",
        "icon": "$(debug-restart)"
      },
      {
        "command": "zedLayout.agents.next",
        "title": "Next Agent Session",
        "category": "Zed Layout"
      },
      {
        "command": "zedLayout.agents.previous",
        "title": "Previous Agent Session",
        "category": "Zed Layout"
      },
      {
        "command": "zedLayout.worktrees.newSession",
        "title": "New Agent Session in Worktree",
        "category": "Zed Layout",
        "icon": "$(git-branch)"
      },
      {
        "command": "zedLayout.worktrees.openInNewWindow",
        "title": "Open Worktree in New Window",
        "category": "Zed Layout",
        "icon": "$(empty-window)"
      },
      {
        "command": "zedLayout.worktrees.compareWithBase",
        "title": "Compare Worktree with Base",
        "category": "Zed Layout",
        "icon": "$(diff)"
      },
      {
        "command": "zedLayout.worktrees.remove",
        "title": "Remove Worktree",
        "category": "Zed Layout",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "Zed-like Agent Workspace",
      "properties": {
        "zedLayout.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Zed-like Agent Workspace extension features."
        },
        "zedLayout.layout.scope": {
          "type": "string",
          "enum": [
            "ask",
            "user",
            "workspace"
          ],
          "default": "ask",
          "description": "Where `Apply Zed Layout` writes settings: ask each time, User settings, or Workspace settings."
        },
        "zedLayout.layout.confirmBeforeApply": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before changing settings."
        },
        "zedLayout.layout.activityBarLocation": {
          "type": "string",
          "enum": [
            "top",
            "hidden"
          ],
          "default": "top",
          "description": "Activity Bar location applied by the preset."
        },
        "zedLayout.layout.hideBreadcrumbs": {
          "type": "boolean",
          "default": false,
          "description": "Hide breadcrumbs when applying the preset."
        },
        "zedLayout.layout.applyTheme": {
          "type": "boolean",
          "default": true,
          "description": "Also switch the color theme when applying the preset."
        },
        "zedLayout.layout.theme": {
          "type": "string",
          "enum": [
            "Zed-like Dark",
            "Zed-like Light"
          ],
          "default": "Zed-like Dark",
          "description": "Color theme applied by the preset (when `zedLayout.layout.applyTheme` is enabled)."
        },
        "zedLayout.typography.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Apply typography settings (fonts, line height, ligatures) as part of the preset."
        },
        "zedLayout.typography.fontFamily": {
          "type": "string",
          "default": "'IBM Plex Mono', 'Lilex', Menlo, Consolas, 'DejaVu Sans Mono', monospace",
          "description": "Editor font family applied by the preset."
        },
        "zedLayout.typography.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 6,
          "maximum": 72,
          "description": "Editor font size applied by the preset."
        },
        "zedLayout.typography.lineHeight": {
          "type": "number",
          "default": 1.6,
          "minimum": 0,
          "description": "Editor line height applied by the preset (values below 8 are a multiplier of font size)."
        },
        "zedLayout.typography.ligatures": {
          "type": "boolean",
          "default": false,
          "description": "Enable font ligatures in the editor."
        },
        "zedLayout.typography.applyToTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Also apply the font family and size to the integrated terminal."
        },
        "zedLayout.agents": {
          "type": "array",
          "description": "Agent CLIs available for new sessions.",
          "default": [
            {
              "id": "claude",
              "label": "Claude Code",
              "command": "claude",
              "args": [],
              "icon": "sparkle",
              "color": "terminal.ansiMagenta"
            },
            {
              "id": "codex",
              "label": "Codex",
              "command": "codex",
              "args": [],
              "icon": "robot",
              "color": "terminal.ansiGreen"
            },
            {
              "id": "agy",
              "label": "Agy",
              "command": "agy",
              "args": [],
              "icon": "rocket",
              "color": "terminal.ansiBlue"
            },
            {
              "id": "kilo",
              "label": "Kilo Code",
              "command": "kilocode",
              "args": [],
              "icon": "zap",
              "color": "terminal.ansiYellow"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "command"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-_]*$",
                "description": "Unique id."
              },
              "label": {
                "type": "string",
                "description": "Display name."
              },
              "command": {
                "type": "string",
                "description": "Executable to run (must be on PATH)."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments."
              },
              "icon": {
                "type": "string",
                "description": "Codicon id for the terminal and Agents view, e.g. \"sparkle\"."
              },
              "color": {
                "type": "string",
                "description": "Theme color id, e.g. \"terminal.ansiMagenta\"."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra environment variables."
              }
            }
          }
        },
        "zedLayout.agentSessionLocation": {
          "type": "string",
          "enum": [
            "editor",
            "panel"
          ],
          "default": "editor",
          "enumDescriptions": [
            "Open agent sessions as editor tabs next to code.",
            "Open agent sessions in the terminal panel."
          ],
          "description": "Where new agent sessions open."
        },
        "zedLayout.status.notifyOnAttention": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a background agent session needs attention."
        },
        "zedLayout.status.waitingAfterSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Treat a running agent as waiting for input after this many seconds without output."
        },
        "zedLayout.worktrees.directory": {
          "type": "string",
          "default": "",
          "description": "Directory for agent worktrees. Empty: \"../<repo>.worktrees\" next to the repository. Relative paths resolve against the repository root."
        },
        "zedLayout.worktrees.branchPrefix": {
          "type": "string",
          "default": "agent/",
          "description": "Prefix for branches created for agent worktrees."
        }
      }
    },
    "themes": [
      {
        "label": "Zed-like Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/zed-like-dark-color-theme.json"
      },
      {
        "label": "Zed-like Light",
        "uiTheme": "vs",
        "path": "./themes/zed-like-light-color-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zedLayoutAgents",
          "title": "Agents",
          "icon": "resources/agents.svg"
        }
      ]
    },
    "views": {
      "zedLayoutAgents": [
        {
          "id": "zedLayout.agentsView",
          "name": "Agents",
          "icon": "resources/agents.svg",
          "contextualTitle": "Zed Layout"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zedLayout.agentsView",
        "contents": "No agent sessions yet.\n[New Agent Session](command:zedLayout.agents.newSession)\n[New Agent Session in Worktree](command:zedLayout.worktrees.newSession)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zedLayout.agents.newSession",
          "when": "view == zedLayout.agentsView",
          "group": "navigation@1"
        },
        {
          "command": "zedLayout.worktrees.newSession",
          "when": "view == zedLayout.agentsView",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "zedLayout.agents.restart",
          "when": "view == zedLayout.agentsView && viewItem =~ /^agentSession/",
          "group": "inline@1"
        },
        {
          "command": "zedLayout.agents.stop",
          "when": "view == zedLayout.agentsView && viewItem =~ /^agentSession/",
          "group": "inline@2"
        },
        {
          "command": "zedLayout.agents.focus",
          "when": "view == zedLayout.agentsView && viewItem =~ /^agentSession/",
          "group": "1_session@1"
        },
        {
          "command": "zedLayout.agents.rename",
          "when": "view == zedLayout.agentsView && viewItem =~ /^agentSession/",
          "group": "1_session@2"
        },
        {
          "command": "zedLayout.agents.restart",
          "when": "view == zedLayout.agentsView && viewItem =~ /^agentSession/",
          "group": "1_session@3"
        },
        {
          "command": "zedLayout.agents.stop",
          "when": "view == zedLayout.agentsView && viewItem =~ /^agentSession/",
          "group": "1_session@4"
        },
        {
          "command": "zedLayout.worktrees.openInNewWindow",
          "when": "view == zedLayout.agentsView && viewItem =~ /^agentSession.*\\.worktree/",
          "group": "2_worktree@1"
        },
        {
          "command": "zedLayout.worktrees.compareWithBase",
          "when": "view == zedLayout.agentsView && viewItem =~ /^agentSession.*\\.worktree/",
          "group": "2_worktree@2"
        },
        {
          "command": "zedLayout.worktrees.remove",
          "when": "view == zedLayout.agentsView && viewItem =~ /^agentSession.*\\.worktree/",
          "group": "2_worktree@3"
        }
      ],
      "commandPalette": [
        {
          "command": "zedLayout.agents.focus",
          "when": "false"
        },
        {
          "command": "zedLayout.agents.rename",
          "when": "false"
        },
        {
          "command": "zedLayout.agents.stop",
          "when": "false"
        },
        {
          "command": "zedLayout.agents.restart",
          "when": "false"
        },
        {
          "command": "zedLayout.worktrees.openInNewWindow",
          "when": "false"
        },
        {
          "command": "zedLayout.worktrees.compareWithBase",
          "when": "false"
        },
        {
          "command": "zedLayout.worktrees.remove",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "npm run compile-tests && npm run build",
    "test": "vscode-test",
    "package": "vsce package --no-dependencies",
    "test:unit": "npm run compile-tests && mocha --ui tdd out/test/layoutPreset.test.js out/test/layoutBackup.test.js out/test/themeContrast.test.js out/test/typography.test.js out/test/agentRegistry.test.js out/test/agentsViewModel.test.js out/test/statusMachine.test.js out/test/worktreeModel.test.js out/test/worktreeService.test.js",
    "themes:generate": "node scripts/generate-themes.mjs && prettier --write themes",
    "themes:contrast": "npm run compile-tests && node scripts/contrast-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.0",
    "mocha": "^11.8.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
